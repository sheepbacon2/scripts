#!/home/wes/.local/share/i3-session/venv/bin/python
"""Save all i3 workspaces; restore snapshots into empty workspaces only."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime
import i3ipc
from i3_resurrect import layout, programs

ROOT = Path(os.environ.get('I3_SESSION_DIR', str(Path.home()/'.local/share/i3-session/snapshots')))

def tell(message):
    print(message, flush=True)
    if shutil.which('notify-send'):
        subprocess.run(['notify-send', 'i3 session', message], check=False)

def command(i3, text):
    replies=i3.command(text)
    if any(not r.success for r in replies):
        raise RuntimeError(f'i3 rejected: {text}')

def workspace(i3, name):
    command(i3, 'workspace --no-auto-back-and-forth '+json.dumps(name,ensure_ascii=False))

def has_windows(node):
    return bool(node.window or node.ipc_data.get("swallows") or any(has_windows(n) for n in node.nodes+node.floating_nodes))

def save(i3):
    stamp=datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    staging=Path(tempfile.mkdtemp(prefix='.saving-',dir=ROOT))
    try:
        workspaces=i3.get_workspaces()
        manifest={'created':datetime.now().isoformat(),'workspaces':[], 'warnings':[]}
        for index, ws in enumerate(workspaces):
            profile=f'ws-{index}'
            layout.save(ws.name,False,staging,profile,['class','instance'])
            programs.save(ws.name,False,staging,profile)
            appfile=staging/f'{profile}_programs.json'
            apps=json.loads(appfile.read_text())
            for con, pid in programs.windows_in_workspace(ws.name,False):
                if pid: continue
                cls=con.get('window_properties',{}).get('class','unknown')
                if cls=='Anki' and Path('/var/lib/flatpak/exports/share/applications/net.ankiweb.Anki.desktop').exists():
                    apps.append({'command':['/usr/bin/flatpak','run','net.ankiweb.Anki'],'working_directory':str(Path.home())})
                else:
                    manifest['warnings'].append(f'{ws.name}: {cls} has no launch command; reopen manually.')
            appfile.write_text(json.dumps(apps,indent=2))
            manifest['workspaces'].append({'name':ws.name,'output':ws.output,'focused':ws.focused,'profile':profile})
        (staging/'session.json').write_text(json.dumps(manifest,indent=2,ensure_ascii=False))
        staging.rename(ROOT/stamp)
        temp=ROOT/'.latest-new'
        temp.symlink_to(stamp)
        temp.replace(ROOT/'latest')
    except BaseException:
        shutil.rmtree(staging,ignore_errors=True)
        raise
    tell(f'Saved {len(workspaces)} workspaces: {stamp}' + ('\n'+'\n'.join(manifest['warnings']) if manifest['warnings'] else ''))

def restore(i3, name, dry_run):
    if name != 'latest' and (Path(name).name != name or name.startswith('.')):
        raise ValueError('Use a snapshot name from i3-session list.')
    folder=ROOT/name
    manifest=json.loads((folder/'session.json').read_text())
    # Read everything before changing the desktop.
    entries=[]
    for ws in manifest['workspaces']:
        profile=ws['profile']
        entries.append((ws,json.loads((folder/f'{profile}_layout.json').read_text()),json.loads((folder/f'{profile}_programs.json').read_text())))
    occupied={ws.name for ws in i3.get_tree().workspaces() if has_windows(ws)}
    outputs={o.name for o in i3.get_outputs() if o.active}
    restored=[]; skipped=[]
    for ws, saved, apps in entries:
        if ws['name'] in occupied:
            skipped.append(ws['name']); continue
        print(f"Restore {ws['name']!r}: {len(apps)} applications",flush=True)
        if dry_run:
            restored.append(ws['name']); continue
        workspace(i3,ws['name'])
        if ws['output'] in outputs:
            command(i3,'move workspace to output '+json.dumps(ws['output']))
        command(i3,'layout '+saved.get('layout','splith'))
        nodes=saved.get('nodes',[])+saved.get('floating_nodes',[])
        if nodes:
            with tempfile.NamedTemporaryFile(mode='w',suffix='.json') as f:
                json.dump(nodes,f); f.flush()
                command(i3,'append_layout '+json.dumps(f.name))
        # argv execution preserves literal arguments; no shell evaluation.
        for app in apps:
            argv=app['command']
            if not isinstance(argv,list):
                raise ValueError('Saved commands must be argument lists.')
            cwd=Path(app['working_directory'])
            subprocess.Popen(argv,cwd=cwd if cwd.is_dir() else Path.home(),stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
        restored.append(ws['name'])
        # Give these applications time to fill their placeholders before the next workspace.
        deadline=time.monotonic()+8
        while nodes and time.monotonic()<deadline:
            live=next((w for w in i3.get_tree().workspaces() if w.name==ws['name']),None)
            if live and not any(n.ipc_data.get("swallows") for n in live.descendants()): break
            time.sleep(.2)
    if not dry_run:
        focused=next((w['name'] for w,_,_ in entries if w['focused']),None)
        if focused: workspace(i3,focused)
    tell(f"{'Preview' if dry_run else 'Restore complete'}: {len(restored)} restored; {len(skipped)} occupied workspaces skipped."+ (' Skipped: '+', '.join(skipped) if skipped else ''))

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action',choices=['save','restore','list','choose'])
    parser.add_argument('snapshot',nargs='?',default='latest')
    parser.add_argument('--dry-run',action='store_true')
    args=parser.parse_args()
    os.umask(0o077); ROOT.mkdir(parents=True,exist_ok=True)
    with (ROOT/'.lock').open('w') as lock:
        try: fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError: raise RuntimeError('Another session action is still running.')
        names=sorted((p.name for p in ROOT.iterdir() if not p.is_symlink() and (p/'session.json').is_file()),reverse=True)
        if args.action=='list':
            print('\n'.join(names)); return
        if args.action=='choose':
            selected=subprocess.run(['rofi','-dmenu','-i','-p','Restore i3 snapshot'],input='\n'.join(names),text=True,capture_output=True)
            if selected.returncode or not selected.stdout.strip(): return
            args.snapshot=selected.stdout.strip()
        i3=i3ipc.Connection()
        if args.action=='save': save(i3)
        else: restore(i3,args.snapshot,args.dry_run)

if __name__=='__main__':
    try: main()
    except Exception as exc:
        tell(f'Failed: {exc}'); sys.exit(1)
